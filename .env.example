# Replace with a DNS name that resolves to this server before starting Caddy.
G1VIEWER_DOMAIN=remote.example.org
OPENDESK_DOMAIN=remote.example.org

# Optional ICE servers. Leave empty for direct/LAN candidates only.
# STUN reveals the connecting public network address to the STUN operator.
G1VIEWER_STUN_URLS=
OPENDESK_STUN_URLS=

# For the optional TURN profile, use the public TURN hostname and both transports.
# Example: turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp
G1VIEWER_TURN_URLS=
G1VIEWER_TURN_REALM=remote.example.org
G1VIEWER_TURN_EXTERNAL_IP=
# Generate a unique secret on the server: openssl rand -hex 32
G1VIEWER_TURN_SHARED_SECRET=
G1VIEWER_TURN_CREDENTIAL_TTL=10m
