{
  "name": "g1viewer",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "A free-first, privacy-focused remote desktop platform",
  "author": "G1Viewer contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/two-client.e2e.mjs",
    "test:visual": "node e2e/visual/capture.mjs",
    "bench:latency": "node e2e/perf/latency.bench.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@nut-tree-fork/libnut": "4.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^26.1.0",
    "puppeteer-core": "25.14.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "com.urstrulyg1.g1viewer",
    "productName": "G1Viewer",
    "copyright": "Copyright © 2025-2026 urstrulyg1",
    "artifactName": "${name}_${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico",
      "build/icons/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${name}_${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} Installer",
      "icon": "build/icon.icns",
      "background": "build/background.tiff",
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 170,
          "y": 250
        },
        {
          "x": 510,
          "y": 250,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 680,
        "height": 450
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${name}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G1Viewer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${name}_x64.${ext}",
      "category": "Network",
      "synopsis": "Consent-based remote desktop",
      "maintainer": "urstrulyg1 <support@urstrulyg1.dev>"
    },
    "appImage": {
      "artifactName": "${name}_x64.${ext}"
    },
    "deb": {
      "artifactName": "${name}_x64.${ext}"
    }
  }
}
