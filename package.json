{
  "name": "g1viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free-first, privacy-focused remote desktop platform",
  "author": "G1Viewer contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/two-client.e2e.mjs",
    "test:visual": "node e2e/visual/capture.mjs",
    "bench:latency": "node e2e/perf/latency.bench.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@nut-tree-fork/libnut": "4.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "^3.0.0",
    "jsdom": "^26.1.0",
    "puppeteer-core": "25.14.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "com.g1viewer.desktop",
    "productName": "G1Viewer",
    "artifactName": "${name}_${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "synopsis": "Consent-based remote desktop",
      "maintainer": "OpenDesk contributors"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
